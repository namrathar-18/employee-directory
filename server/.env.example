# Server environment
NODE_ENV=development
PORT=4000

# MongoDB connection string (Atlas or local). Remember to include the database name.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/employee_directory?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/employee_directory

# Allowed origin(s) for the web client (comma separated). Use * to allow all.
CLIENT_ORIGIN=http://localhost:5173
